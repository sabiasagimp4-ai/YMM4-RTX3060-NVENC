<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <Compile Include="../../NVEncVideoWriterPlugin/FrameCacheKey.cs" Link="FrameCacheKey.cs" />
    <Compile Include="../../NVEncVideoWriterPlugin/KeyDependencyTracker.cs" Link="KeyDependencyTracker.cs" />
    <Compile Include="../../NVEncVideoWriterPlugin/FrameDependencyIndex.cs" Link="FrameDependencyIndex.cs" />
    <Compile Include="../../NVEncVideoWriterPlugin/FileDependencyLease.cs" Link="FileDependencyLease.cs" />
    <Compile Remove="StoreChecks.cs" />
    <Using Include="System.IO" />
    <Reference Include="YukkuriMovieMaker"><HintPath>$(YMM4DirPath)YukkuriMovieMaker.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="YukkuriMovieMaker.Plugin"><HintPath>$(YMM4DirPath)YukkuriMovieMaker.Plugin.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(YMM4DirPath)Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Vortice.Mathematics"><HintPath>$(YMM4DirPath)Vortice.Mathematics.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
